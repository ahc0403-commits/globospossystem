  "sharedAreas": [
    {
      "id": "bootstrap",
      "paths": [
        "lib/main.dart",
        "lib/core/router/*",
        "lib/core/permissions*",
        "lib/core/*/auth*"
      ],
      "affectsAllFeatures": true
    },
    {
      "id": "database",
      "paths": [
        "supabase/migrations/*",
        "supabase/schema.sql",
        "scripts/*.sql"
      ],
      "affectsAllFeatures": true
    },
    {
      "id": "edge",
      "paths": [
        "supabase/functions/*"
      ],
      "affectsAllFeatures": true
    },
    {
      "id": "web-platform",
      "paths": [
        "web/*",
        "assets/*",
        "packages/*",
        "android/*",
        "ios/*",
        "macos/*",
        "windows/*",
        "linux/*"
      ],
      "affectsAllFeatures": true
    },
    {
      "id": "shared-dart",
      "paths": [
        "lib/core/*"
      ],
      "affectsAllFeatures": false
    },
    {
      "id": "verification",
      "paths": [
        "scripts/*",
        "test/*",
        "integration_test/*",
        ".github/*"
      ],
      "affectsAllFeatures": false
    },
    {
      "id": "project-policy",
      "paths": [
        "AGENTS.md",
        "CLAUDE.md",
        "docs/*",
        ".claude/*"
      ],
      "affectsAllFeatures": false
    }
