{
  "schemaVersion": 1,
  "platform": "ubuntu-24.04-x86_64",
  "tools": {
    "flutter": "3.41.6",
    "dart": "3.11.4",
    "node": "v22.22.0",
    "deno": "2.7.13",
    "chrome": "156.0.8078.47"
  },
  "steps": [
    {
      "id": "change-governance-contract",
      "argv": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/governance/tests",
        "-v"
      ],
      "format": "unittest",
      "timeoutSeconds": 120
    },
    {
      "id": "resilience-tooling-contract",
      "argv": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/resilience/tests",
        "-v"
      ],
      "format": "unittest",
      "timeoutSeconds": 120
    },
    {
      "id": "local-gate-contract",
      "argv": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/local_verification/tests",
        "-v"
      ],
      "format": "unittest",
      "timeoutSeconds": 120
    },
    {
      "id": "independent-receipt-verifier-contract",
      "argv": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/receipt_verification/tests",
        "-v"
      ],
      "format": "unittest",
      "timeoutSeconds": 120
    },
    {
      "id": "cloud-transport-contract",
      "argv": [
        "python3",
        "-B",
        "-m",
        "unittest",
        "discover",
        "-s",
        "scripts/cloud_deployment",
        "-p",
        "test_*.py",
        "-v"
      ],
      "format": "unittest",
      "timeoutSeconds": 120
    },
    {
      "id": "cloud-authenticated-driver-contract",
      "argv": [
        "node",
        "--test",
        "scripts/cloud_deployment/test_driver.cjs"
      ],
      "format": "node",
      "timeoutSeconds": 120
    },
    {
      "id": "cloud-migration-atomicity",
      "argv": [
        "python3",
        "-B",
        "scripts/cloud_deployment/integration_migration.py"
      ],
      "format": "unittest",
      "timeoutSeconds": 120
    },
    {
      "id": "cloud-procurement-migration",
      "argv": [
        "env",
        "POS_TEST_CLOUD_MIGRATION=1",
        "bash",
        "scripts/test_procurement_v2.sh"
      ],
      "format": "command",
      "timeoutSeconds": 600
    },
    {
      "id": "kds-progress-receipt-sql",
      "argv": [
        "python3",
        "-B",
        "scripts/resilience/integration_kds_receipts.py",
        "-v"
      ],
      "format": "unittest",
      "timeoutSeconds": 120
    },
    {
      "id": "browser-kds-outbox-compatibility",
      "argv": [
        "node",
        "--test",
        "scripts/resilience/tests/kds_outbox_browser.test.cjs"
      ],
      "format": "node",
      "timeoutSeconds": 120
    },
    {
      "id": "browser-payment-intent-journal",
      "argv": [
        "node",
        "--test",
        "scripts/resilience/tests/payment_journal_browser.test.cjs"
      ],
      "format": "node",
      "timeoutSeconds": 120
    },
    {
      "id": "native-kds-json-resources",
      "argv": [
        "flutter",
        "test",
        "--no-pub",
        "--machine",
        "--enable-vmservice",
        "test/resilience/native_rpc_resource_probe.dart"
      ],
      "format": "flutter",
      "timeoutSeconds": 120
    },
    {
      "id": "repository",
      "argv": [
        "bash",
        "scripts/check_repo.sh"
      ],
      "format": "repository",
      "timeoutSeconds": 7200
    },
    {
      "id": "password-lifecycle-edge",
      "argv": [
        "deno",
        "test",
        "--allow-env=ALLOWED_ORIGINS",
        "supabase/functions/complete-initial-password-change/index_test.ts"
      ],
      "format": "deno",
      "timeoutSeconds": 600
    },
    {
      "id": "sepay-webhook-edge",
      "argv": [
        "deno",
        "test",
        "supabase/functions/sepay-webhook/index_test.ts"
      ],
      "format": "deno",
      "timeoutSeconds": 600
    },
    {
      "id": "emergency-fulfillment-edge",
      "argv": [
        "deno",
        "test",
        "supabase/functions/emergency-fulfillment-dispatcher/index_test.ts"
      ],
      "format": "deno",
      "timeoutSeconds": 600
    },
    {
      "id": "public-receipt-security-edge",
      "argv": [
        "deno",
        "test",
        "--config",
        "supabase/functions/public-receipt/deno.json",
        "supabase/functions/public-receipt/index_test.ts"
      ],
      "format": "deno",
      "timeoutSeconds": 600
    },
    {
      "id": "browser-terminal-authentication",
      "argv": [
        "flutter",
        "test",
        "--no-pub",
        "--machine",
        "--platform",
        "chrome",
        "test/terminal_auth_browser_test.dart"
      ],
      "format": "flutter",
      "timeoutSeconds": 600
    },
    {
      "id": "restaurant-finalization-regression",
      "argv": [
        "bash",
        "scripts/test_restaurant_finalizations.sh"
      ],
      "format": "command",
      "timeoutSeconds": 600
    }
  ],
  "coverage": {
    "inventory_workflow_contract.yml": "repository:inventory_workflow_sql -> scripts/test_inventory_workflow_all_stores.sh",
    "procurement_contract.yml": "repository:inventory_workflow_sql -> scripts/test_procurement_v2.sh",
    "pos_release_contract.yml": [
      "repository",
      "browser-terminal-authentication"
    ],
    "restaurant_finalization.yml": "restaurant-finalization-regression",
    "windows_print_station_build.yml": "scripts/build_windows_print_station.ps1 on local Windows x64; separate native package scope, never counted as Linux PASS"
  }
}
